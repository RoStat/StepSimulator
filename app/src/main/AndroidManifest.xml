<?xml version="1.0" encoding="utf-8"?>
<!--
  StepSimulator v3 : manifeste Android.
  Aucune ressource XML (layout, thème, icône) : l'interface est construite en Kotlin,
  le thème et l'icône par défaut du système sont utilisés, pour rester minimal.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Écriture des pas dans Health Connect (permission "santé", accordée dans l'écran Health Connect) -->
    <uses-permission android:name="android.permission.health.WRITE_STEPS" />
    <!-- Écriture de la distance (option "écrire aussi la distance") -->
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <!-- Notification de compte rendu après chaque écriture (Android 13+ : permission à l'exécution) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Réarmer l'alarme quotidienne après un redémarrage du téléphone -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Bouton "Exclure de l'optimisation batterie" (boîte de dialogue système) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 13 et moins : rendre l'app Health Connect (Play Store) visible pour détecter sa présence -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:label="Step Simulator"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.Light">

        <!-- Écran principal : diagnostic, permission, "Tester maintenant" -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Android 13 et moins : Health Connect ouvre cet écran pour la "justification" des permissions -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- Android 14+ : même justification, via l'alias exigé par le système -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <!--
          Récepteur unique : alarme quotidienne (6h35) + redémarrage.
          exported="false" suffit : les diffusions système (BOOT_COMPLETED, alarme) passent
          quand même, seules les autres applications sont bloquées.
        -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
